{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "moduleDetection": "force",
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "aula2/**/*",
    "aula3/**/*",
    "aula4/**/*",
    "aula5/**/*",
    "aula6/**/*",
    "aula7/**/*",
    "aula8/**/*",
    "aula9/**/*",
    "aula10/**/*",
    "aula11/**/*",
    "beecrowd/**/*"
  ]
}
